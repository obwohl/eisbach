__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Scratch data. The archive under data/archive/ is the exception: it is the only copy
# of every forecast we have ever made, and of the DWD forecasts as they were issued.
data/*
!data/archive/
!data/archive/**

# ...but not the half-written partitions. _write_partition writes <partition>.csv.tmp
# and then os.replace()s it; an interrupted run leaves one behind, and CI's blanket
# `git add data/archive` would commit it into the one store we cannot rebuild.
data/archive/**/*.tmp

# The model checkpoint is fetched on demand and verified against a pinned SHA256,
# so it never belongs in git.
data/model/

# Generated outputs. CI copies these into public/ and deploys them to GitHub Pages with
# actions/upload-pages-artifact, which bypasses git entirely — see
# .github/workflows/forecast.yml. Committing them here is what grew .git to 175 MB.
Prediction.png
Prediction_Backtest.png
Prediction.csv
public/

*.log
*.pid

